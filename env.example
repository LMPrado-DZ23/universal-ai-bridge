# ── Universal AI Bridge — configuração ────────────────────────────────
# Copie este arquivo para  .env  (mesmo diretório) e ajuste os valores.

# Raiz do workspace: TUDO que a IA lê/escreve/executa fica preso aqui.
# Deixe em branco para usar ./workspace (ao lado do projeto), ou aponte
# para uma pasta sua. Ex.: C:\Users\SEU_USUARIO\ai-workspace
BRIDGE_WORKSPACE=

# Token de autenticação para o transporte HTTP (browser).
# GERE UM FORTE: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem token definido, o transporte HTTP RECUSA subir (fail-safe).
BRIDGE_TOKEN=troque-por-um-token-aleatorio-forte

# Porta do servidor HTTP local (o cloudflared aponta para ela).
BRIDGE_PORT=8787

# Origins permitidos no transporte HTTP (CSV). Protege contra DNS rebinding.
BRIDGE_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai

# Modo de aprovação para ações com efeito colateral (write/shell/etc):
#   auto    = executa direto (só use em workspace descartável)
#   confirm = exige um segundo passo confirmado (padrão, mais seguro)
BRIDGE_APPROVAL=confirm

# Permitir o tool run_command? (true/false). Desligue se só quer arquivos.
BRIDGE_ALLOW_SHELL=true
