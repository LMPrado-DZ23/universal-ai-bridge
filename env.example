# ── Universal AI Bridge — configuração ────────────────────────────────
# Copie este arquivo para  .env  (mesmo diretório) e ajuste os valores.
# O servidor carrega o .env automaticamente (parser nativo do Node).

# ── MODO ──────────────────────────────────────────────────────────────
# safe  = padrão. Workspace jaulado, shell só com opt-in, Docker BLOQUEADO.
# admin = acesso amplo (shell ligado, Docker liberável). Exige o
#         reconhecimento abaixo, senão o servidor NEM sobe.
BRIDGE_MODE=safe

# Só necessário se BRIDGE_MODE=admin. Precisa ser exatamente esta frase:
# BRIDGE_ADMIN_ACK=I_UNDERSTAND_FULL_PC_ACCESS
BRIDGE_ADMIN_ACK=

# ── SEGREDO / REDE ────────────────────────────────────────────────────
# Token do transporte HTTP (browser). GERE UM FORTE:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem token, o transporte HTTP RECUSA subir (fail-safe).
BRIDGE_TOKEN=troque-por-um-token-aleatorio-forte

BRIDGE_PORT=8787

# Origins permitidos no HTTP (CSV). Protege contra DNS rebinding.
BRIDGE_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai

# Plano de controle LOCAL (porta separada = BRIDGE_PORT+1, não exposta pelo túnel):
# permite parar tudo, revogar e rotacionar o token. Em branco = gerado e salvo
# em <dados>/admin.secret. O painel usa este segredo.
BRIDGE_ADMIN_SECRET=
# BRIDGE_ADMIN_PORT=8788    # padrão: BRIDGE_PORT + 1
# Máximo de sessões HTTP simultâneas.
BRIDGE_MAX_SESSIONS=20

# ── WORKSPACE ─────────────────────────────────────────────────────────
# Raiz das operacoes de caminho. Node/Python/Docker autorizados NAO sao sandbox.
# Em branco = ./workspace. Ex.: C:\Users\SEU_USUARIO\ai-workspace
BRIDGE_WORKSPACE=

# ── APROVAÇÃO ─────────────────────────────────────────────────────────
# auto    = executa direto (só workspace descartável)
# confirm = duas etapas no canal da IA (padrão; NÃO é aprovação humana)
# local   = código sai só no console local; humano precisa relé-lo à IA
BRIDGE_APPROVAL=confirm

# ── CAPACIDADES ───────────────────────────────────────────────────────
# Shell (run_command/run_job). Em safe só liga com "true"; em admin já vem ligado.
BRIDGE_ALLOW_SHELL=false

# Docker (só tem efeito em modo admin). "true" para liberar.
BRIDGE_ALLOW_DOCKER=false

# ── TÚNEL (opcional) ──────────────────────────────────────────────────
# Em branco = túnel rápido do cloudflared (URL muda a cada reinício).
# Para URL FIXA: crie um túnel nomeado no painel da Cloudflare, cole o token
# aqui e informe o hostname público que você mapeou para http://127.0.0.1:8787.
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_HOSTNAME=

# Revisão de hardening: flags estritas true/false.
BRIDGE_AUDIT_REQUIRED=false
# BRIDGE_APPROVAL=human_local exige HTTP + painel local Windows.
# Limites opcionais; veja README. Exemplos:
# BRIDGE_LIMIT_ACTIVE_JOBS=4
# BRIDGE_LIMIT_GLOBAL_JOBS=32
# BRIDGE_LIMIT_CONCURRENT_REQUESTS=4

# Precedencia: BRIDGE_ENV_FILE seleciona arquivo unico (erro se ausente).
# Config herdada prevalece, EXCETO BRIDGE_TOKEN persistido, inclusive vazio.
# Revogacao persistida impede reinicio HTTP ate reconfiguracao local do token.
