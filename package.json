{
  "name": "universal-ai-bridge",
  "version": "0.7.0",
  "description": "Um servidor MCP local (stdio + Streamable HTTP) que deixa qualquer IA no navegador (ChatGPT, Claude.ai) ou local (Claude Desktop, Cursor, Gemini CLI) criar e executar projetos no seu PC com policy engine, jaula de workspace, auth e audit log.",
  "type": "module",
  "bin": {
    "universal-ai-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http",
    "dev:http": "tsx watch src/index.ts --transport http",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:source": "node scripts/check-source.mjs",
    "pretest": "npm run build",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
