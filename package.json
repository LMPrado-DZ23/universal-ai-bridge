{
  "name": "universal-ai-bridge",
  "version": "0.1.0",
  "description": "Um servidor MCP local (stdio + Streamable HTTP) que deixa qualquer IA no navegador (ChatGPT, Claude.ai) ou local (Claude Desktop, Cursor, Gemini CLI) criar e executar projetos no seu PC com policy engine, jaula de workspace, auth e audit log.",
  "type": "module",
  "bin": {
    "universal-ai-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http",
    "dev:http": "tsx watch src/index.ts --transport http",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
